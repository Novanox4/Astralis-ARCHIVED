type: ItemTurret
name: Tempest
description: Launches a spread of electric bombs along with a beam capable of pulling targets towards it.
details: "My child will NOT throw rocks covered in copper wiring at power lines!"
//ignore the wonky text it just got bugged because of different indents
consumes: {
 power: 6
 }
ammoPerShot: 7
predictTarget: false
squareSprite: false
size: 4
category: turret
minWarmup: 0.87
requirements: [
  item-crystalite/175
  item-uranium/350
  item-silver/200
  metaglass/150
  item-hadalrock/125
  ]
shootSound: laser
recoils: 2
shoot: {
 type: ShootBarrel
 shots: 1
 barrels: [
    -8, 3.25, 0,
    8, 3.25, 0
  ]
}
outlineColor: 323232
