  type: DrawTurret
  basePrefix: astral-
  parts: [
    {
    type: RegionPart
    suffix: -barrel-1
    moveY: -4
    progress: recoil
    recoilIndex: 0
    }
    {
    type: RegionPart
    suffix: -barrel-2
    moveY: -4
    progress: recoil
    recoilIndex: 1
    }
    {
    type: RegionPart
    suffix: -center
    moveY: -0.2
    progress: recoil
    }
    {
    type: RegionPart
    suffix: -side-r
    recoilIndex: 0
    progress: warmup
    moveY: 1
    moveRot: -22
    moves: [
      {
      type: PartMove
      progress: recoil
      rot: 22
      y: -1
      }
    ]
    }
    {
    type: RegionPart
    suffix: -side-l
    recoilIndex: 1
    progress: warmup
    moveY: 1
    moveRot: 22
    moves: [
      {
      type: PartMove
      progress: recoil
      rot: -22
      y: -1
      }
    ]
    }
  ]
}
